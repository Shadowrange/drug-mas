# Скопируйте этот файл в .env перед запуском: cp .env.example .env

# Ключ и параметры OpenAI-совместимого API (не требуются при OFFLINE=1)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Режим работы:
# 1 — полностью автономный режим (все ответы БД и LLM берутся из папки cache/, без запросов в сеть)
# 0 — онлайн-режим с обращением к внешним API и автоматическим сохранением ответов в cache/
OFFLINE=1
CACHE_DIR=./cache
